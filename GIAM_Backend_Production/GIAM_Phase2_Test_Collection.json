{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-1234-567890abcdef",
		"name": "GIAM Phase 2 API Collection",
		"description": "Comprehensive Postman collection for testing GIAM Phase 2 features including Project Sync, SSO Handoff, and API Hardening rules.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.status === 'success') {",
									"    pm.environment.set('bearer_token', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@giam.local\",\n    \"password\": \"<SET_TEST_PASSWORD>\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						}
					}
				}
			]
		},
		{
			"name": "2. Downstream Project Sync (Server-to-Server)",
			"item": [
				{
					"name": "Sync Roles & Permissions",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-App-Id",
								"value": "{{app_id}}",
								"type": "text"
							},
							{
								"key": "X-Api-Key",
								"value": "{{api_key}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"modules\": [\n        {\n            \"name\": \"HR Management\",\n            \"description\": \"HR Module\",\n            \"identifier\": \"hr_module\"\n        }\n    ],\n    \"roles\": [\n        {\n            \"name\": \"HR Admin\",\n            \"description\": \"Full HR access\"\n        }\n    ],\n    \"permissions\": [\n        {\n            \"name\": \"Hire Employee\",\n            \"group_name\": \"Recruitment\",\n            \"module_identifier\": \"hr_module\"\n        }\n    ],\n    \"role_permissions\": [\n        {\n            \"role_name\": \"HR Admin\",\n            \"permissions\": [\"Hire Employee\"]\n        }\n    ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/sync/roles-permissions",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"sync",
								"roles-permissions"
							]
						}
					}
				},
				{
					"name": "Get Sync Status",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-App-Id",
								"value": "{{app_id}}",
								"type": "text"
							},
							{
								"key": "X-Api-Key",
								"value": "{{api_key}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/sync/status",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"sync",
								"status"
							]
						}
					}
				}
			]
		},
		{
			"name": "3. SSO Handoff Flow",
			"item": [
				{
					"name": "Generate SSO Token (GIAM Frontend)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.status === 'success') {",
									"    pm.environment.set('sso_token', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{bearer_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"application_id\": {{app_id}}\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/sso/generate-token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"sso",
								"generate-token"
							]
						}
					}
				},
				{
					"name": "Exchange SSO Token (Downstream Backend)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-App-Id",
								"value": "{{app_id}}",
								"type": "text"
							},
							{
								"key": "X-Api-Key",
								"value": "{{api_key}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"token\": \"{{sso_token}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/sso/exchange-token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"sso",
								"exchange-token"
							]
						}
					}
				}
			]
		},
		{
